# =============================================================
# COOU Attendance Frontend — Environment Variables
# Copy this file to .env and fill in real values.
# =============================================================

# Backend API base URL — set this on Vercel to your deployed backend URL.
# Example: https://attendance-website-backend.vercel.app
# Leave empty (or omit) for local dev — Vite's proxy handles /api/* automatically.
VITE_API_BASE_URL=
